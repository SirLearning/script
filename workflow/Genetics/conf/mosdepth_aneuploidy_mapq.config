/*
 * Parallelism for partial_task aneuploidy_mapq (one task per BAM).
 * Pass alongside nextflow.config:
 *   -c workflow/Genetics/conf/mosdepth_aneuploidy_mapq.config
 */

params.mapq_bin_size_bp = 1000000
params.mapq_samtools_threads = 4
params.mapq_max_forks = 64
params.mapq_skip_existing = true
params.mapq_plot = false
params.taxa_bam_map = "${params.home_dir}/00data/05taxaBamMap/final.ALL.taxaBamMap.txt"

process {
    withName: 'bam_mapq_depth_bin_sample' {
        cpus = 2
        memory = '2 GB'
        maxForks = params.mapq_max_forks ?: 16
    }
}
