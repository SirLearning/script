/*
 * Single-sample mosdepth via mosdepth_single_bam.nf (ct_depth_with_mosdepth).
 * Pass alongside nextflow.config: -c .../conf/mosdepth_single_bam.config
 *
 * Override on the CLI for MAPQ-filtered N500, e.g.:
 *   --mosdepth_cpus 8 --mosdepth_max_forks 8 --mosdepth_mapq 30
 */
params.mosdepth_cpus = 10
params.mosdepth_mapq = 0
params.mosdepth_max_forks = 0

process {
    withName: 'ct_depth_with_mosdepth' {
        cpus = params.mosdepth_cpus
        memory = '32 GB'
    }
}
