/*
 * Parallelism for partial_task aneuploidy_breachr (flagged samples with MAPQ TSVs).
 * Pass alongside nextflow.config:
 *   -c workflow/Genetics/conf/breachr_flagged.config
 */

params.breachr_min_cnv_length_bp = 2000000
params.breachr_min_cnv_bins = 2
params.breachr_max_forks = 32

process {
    withName: 'breachr_segment_sample' {
        cpus = 1
        memory = '1 GB'
        maxForks = params.breachr_max_forks ?: 32
    }
    withName: 'breachr_mapq_depth_cap_plot' {
        cpus = 1
        memory = '1 GB'
        maxForks = params.breachr_max_forks ?: 32
    }
    withName: 'breachr_reconcile_flagged' {
        cpus = 1
        memory = '2 GB'
    }
}
