params {
    mapq_popdep_prefix      = 'allmapq_1mb'
    mapq_popdep_depth_mode  = 'all'
    mapq_popdep_engine      = 'polars'
    mapq_popdep_cpus        = 32
    mapq_popdep_memory      = '64 GB'
    mapq_popdep_min_reads   = 1
    mapq_popdep_min_samples = 3
}

process {
    withName: 'mapq_bin_popdep_build' {
        cpus   = params.mapq_popdep_cpus
        memory = params.mapq_popdep_memory
    }
}
