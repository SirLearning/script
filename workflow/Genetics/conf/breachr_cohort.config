/*
 * Parallelism for partial_task aneuploidy_breachr_cohort (full MAPQ cohort).
 * Pass alongside nextflow.config:
 *   -c workflow/Genetics/conf/breachr_cohort.config
 */

params.breachr_info_subdir = 'breachr_cohort'
params.breachr_skip_existing = true
params.breachr_max_forks = 64

process {
    withName: 'breachr_segment_sample' {
        cpus = 1
        memory = '1 GB'
        maxForks = params.breachr_max_forks ?: 64
    }
    withName: 'breachr_merge_segments_cohort' {
        cpus = 1
        memory = '8 GB'
    }
}
