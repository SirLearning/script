process {
    executor = 'local'
    cpus = 8
    memory = 64.GB
    errorStrategy = 'ignore'

    withLabel: cpus_16 {
        cpus = 16
        memory = 128.GB
    }

    withLabel: 'test_popdep_chr' {
        cpus = 8
        memory = 64.GB
        maxForks = 6
    }

    withLabel: cpus_32 {
        cpus = 32
        memory = 256.GB
    }

    withLabel: 'rare_inter_extract' {
        cpus = 16
        memory = 256.GB
        maxForks = 3
        errorStrategy = 'retry'
        maxRetries = 2
    }

    withLabel: 'cpus_64' {
        cpus = 64
        memory = 512.GB
    }

    withLabel: 'cpus_128' {
        cpus = 128
        memory = 1024.GB
    }

    withLabel: 'fastcall3_disc' {
        cpus = { params.chr ? 96 : 16 }
        memory = { (params.chr ? 256.GB : 96.GB) + (16.GB * task.attempt) }
        maxForks = 8
        errorStrategy = 'retry'
        maxRetries = 3
    }

    withLabel: 'fastcall3_blib' {
        cpus = { params.chr ? 96 : 16 }
        memory = { (params.chr ? 256.GB : 128.GB) + (8.GB * task.attempt) }
        errorStrategy = 'retry'
        maxRetries = 3
    }

    withLabel: 'fastcall3_scan' {
        cpus = { params.chr ? 96 : 64 }
        memory = { (params.chr ? 768.GB : 640.GB) + (128.GB * task.attempt) }
        errorStrategy = 'ignore'
    }

    withLabel: 'fastcall3_scan_iac' {
        cpus = { params.chr ? 96 : 64 }
        memory = { (params.chr ? 768.GB : 640.GB) + (128.GB * task.attempt) }
        errorStrategy = 'ignore'
    }

    withLabel: 'fastcall3_scan2' {
        cpus = 32
        memory = { 640.GB + (128.GB * task.attempt) }
        errorStrategy = 'ignore'
    }

    withLabel: 'fastcall3_scan3' {
        // Scan3 streams merged AD and writes the VCF single-threaded, so a task
        // only uses ~2 cores: raise concurrency by running several chromosomes at
        // once (--scan3_cpus 8 with 192 slots gives 24) rather than -j. Live heap
        // measured at 9.8 GB after a full GC, so --scan3_memory_gb 50 leaves room.
        cpus = { params.scan3_cpus ?: 32 }
        memory = { (params.scan3_memory_gb ?: 640).toInteger().GB + (128.GB * (task.attempt - 1)) }
        errorStrategy = 'ignore'
    }

    withLabel: 'fastcall3_scan4' {
        cpus = 8
        memory = { 32.GB + (16.GB * task.attempt) }
        errorStrategy = 'ignore'
    }

    withLabel: 'fastcall3_vlib' {
        cpus = 4
        memory = 16.GB
        errorStrategy = 'retry'
        maxRetries = 1
    }

    withLabel: 'fastcall3_clib' {
        cpus = 4
        memory = 16.GB
        errorStrategy = 'retry'
        maxRetries = 1
    }

    withLabel: 'site_mq_bcftools' {
        // mpileup is I/O-bound (~1 CPU effective); prefer many low-cpu forks over few x32-thread tasks
        cpus = 4
        memory = 64.GB
        maxForks = 16
        errorStrategy = 'retry'
        maxRetries = 1
    }

    withLabel: 'popdep_tiger' {
        cpus = {
            params.popdep_tiger_threads != null
                ? "${params.popdep_tiger_threads}".toInteger()
                : (params.popdep_tiger_app == 'PopDepFull' ? 32 : 16)
        }
        memory = {
            params.popdep_tiger_memory_gb != null
                ? "${params.popdep_tiger_memory_gb}".toInteger().GB
                : (params.popdep_tiger_app == 'PopDepFull' ? 640.GB : 64.GB)
        }
        maxForks = params.popdep_tiger_max_forks
        errorStrategy = 'retry'
        maxRetries = 1
    }

    withLabel: 'popdep_tiger_crosschr' {
        cpus = params.popdep_crosschr_threads
        memory = { "${params.popdep_crosschr_memory_gb}".toInteger().GB }
        maxForks = 1
        errorStrategy = 'retry'
        maxRetries = 1
    }

    withLabel: 'popdep_loo_tiger' {
        cpus = {
            params.popdep_tiger_threads != null
                ? "${params.popdep_tiger_threads}".toInteger()
                : 32
        }
        memory = {
            params.popdep_loo_tiger_memory_gb != null
                ? "${params.popdep_loo_tiger_memory_gb}".toInteger().GB
                : 128.GB
        }
        maxForks = params.popdep_loo_max_forks
        errorStrategy = 'retry'
        maxRetries = 1
    }

    withLabel: 'site_anno_stream' {
        // One sequential pass over a ~10 GB featHighRes BED. bgzip decompression
        // is the bottleneck and the files sit on the same disk, so keep forks
        // modest rather than starting all 21 chromosomes at once.
        cpus = 4
        memory = 32.GB
        maxForks = 8
        errorStrategy = 'retry'
        maxRetries = 1
    }

    withLabel: 'wap_exon_extract' {
        cpus = 16
        memory = 128.GB
        maxForks = 4
        errorStrategy = 'retry'
        maxRetries = 1
    }

    withLabel: 'snpeff_build' {
        cpus = 8
        memory = 64.GB
        maxForks = 1
        errorStrategy = 'retry'
        maxRetries = 1
    }

    withLabel: 'snpeff_ann' {
        cpus = 8
        memory = 32.GB
        maxForks = 3
        errorStrategy = 'retry'
        maxRetries = 1
    }

    withLabel: 'popdep_bgz_tabix' {
        cpus = 8
        memory = 32.GB
        maxForks = 16
        errorStrategy = 'retry'
        maxRetries = 1
    }

    withLabel: singer_window {
        cpus = 4
        memory = 16.GB
        maxForks = 32
    }

    withLabel: singer_arg {
        cpus = 1
        memory = 16.GB
        maxForks = 64
        errorStrategy = 'ignore'
        maxRetries = 0
    }
}

executor {
    name = 'local'
    cpus = 128
    memory = 1792.GB
}
